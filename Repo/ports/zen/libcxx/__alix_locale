#endif

#define _LIBCPP_COLLATE_MASK LC_COLLATE_MASK
#define _LIBCPP_CTYPE_MASK LC_CTYPE_MASK
#define _LIBCPP_MONETARY_MASK LC_MONETARY_MASK
#define _LIBCPP_NUMERIC_MASK LC_NUMERIC_MASK
#define _LIBCPP_TIME_MASK LC_TIME_MASK
#define _LIBCPP_MESSAGES_MASK LC_MESSAGES_MASK
#define _LIBCPP_ALL_MASK LC_ALL_MASK
#define _LIBCPP_LC_ALL LC_ALL

_LIBCPP_BEGIN_NAMESPACE_STD
namespace __locale {

using __locale_t _LIBCPP_NODEBUG = ::locale_t;

struct __locale_guard {
  _LIBCPP_HIDE_FROM_ABI explicit __locale_guard(__locale_t locale) : previous_(::uselocale(locale)) {}
  _LIBCPP_HIDE_FROM_ABI ~__locale_guard() {
    if (previous_)
      ::uselocale(previous_);
  }
  __locale_t previous_;
  __locale_guard(const __locale_guard&) = delete;
  __locale_guard& operator=(const __locale_guard&) = delete;
};

#if defined(_LIBCPP_BUILDING_LIBRARY)
using __lconv_t _LIBCPP_NODEBUG = std::lconv;

inline _LIBCPP_HIDE_FROM_ABI __locale_t __newlocale(int mask, const char* name, __locale_t base) {
  return ::newlocale(mask, name, base);
}
inline _LIBCPP_HIDE_FROM_ABI void __freelocale(__locale_t locale) { ::freelocale(locale); }
inline _LIBCPP_HIDE_FROM_ABI char* __setlocale(int category, const char* name) {
  return ::setlocale(category, name);
}
inline _LIBCPP_HIDE_FROM_ABI __lconv_t* __localeconv(__locale_t& locale) {
  __locale_guard selected(locale);
  return std::localeconv();
}
inline _LIBCPP_HIDE_FROM_ABI decltype(MB_CUR_MAX) __mb_len_max(__locale_t locale) {
  __locale_guard selected(locale);
  return MB_CUR_MAX;
}
inline _LIBCPP_HIDE_FROM_ABI int __toupper(int value, __locale_t) { return std::toupper(value); }
inline _LIBCPP_HIDE_FROM_ABI int __tolower(int value, __locale_t) { return std::tolower(value); }
inline _LIBCPP_HIDE_FROM_ABI int __strcoll(const char* first, const char* second, __locale_t) {
  return std::strcoll(first, second);
}
inline _LIBCPP_HIDE_FROM_ABI size_t __strxfrm(char* output, const char* input, size_t capacity, __locale_t) {
  return std::strxfrm(output, input, capacity);
}
inline _LIBCPP_HIDE_FROM_ABI size_t __strftime(char* output, size_t capacity, const char* format,
                                             const tm* value, __locale_t) {
  return std::strftime(output, capacity, format, value);
}
#if _LIBCPP_HAS_WIDE_CHARACTERS
inline _LIBCPP_HIDE_FROM_ABI int __iswctype(wint_t value, unsigned long mask, __locale_t) {
  // These are libc++'s _LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE bits, not Alix's
  // opaque wctype_t descriptors. The native acceptance probe asserts the
  // actual ctype_base constants before testing every mask combination.
  return ((mask & (1UL << 0)) && std::iswspace(value)) ||
         ((mask & (1UL << 1)) && std::iswprint(value)) ||
         ((mask & (1UL << 2)) && std::iswcntrl(value)) ||
         ((mask & (1UL << 3)) && std::iswupper(value)) ||
         ((mask & (1UL << 4)) && std::iswlower(value)) ||
         ((mask & (1UL << 5)) && std::iswalpha(value)) ||
         ((mask & (1UL << 6)) && std::iswdigit(value)) ||
         ((mask & (1UL << 7)) && std::iswpunct(value)) ||
         ((mask & (1UL << 8)) && std::iswxdigit(value)) ||
         ((mask & (1UL << 9)) && std::iswblank(value));
}
inline _LIBCPP_HIDE_FROM_ABI int __iswspace(wint_t value, __locale_t) { return std::iswspace(value); }
inline _LIBCPP_HIDE_FROM_ABI int __iswprint(wint_t value, __locale_t) { return std::iswprint(value); }
inline _LIBCPP_HIDE_FROM_ABI int __iswcntrl(wint_t value, __locale_t) { return std::iswcntrl(value); }
inline _LIBCPP_HIDE_FROM_ABI int __iswupper(wint_t value, __locale_t) { return std::iswupper(value); }
inline _LIBCPP_HIDE_FROM_ABI int __iswlower(wint_t value, __locale_t) { return std::iswlower(value); }
inline _LIBCPP_HIDE_FROM_ABI int __iswalpha(wint_t value, __locale_t) { return std::iswalpha(value); }
inline _LIBCPP_HIDE_FROM_ABI int __iswblank(wint_t value, __locale_t) { return std::iswblank(value); }
inline _LIBCPP_HIDE_FROM_ABI int __iswdigit(wint_t value, __locale_t) { return std::iswdigit(value); }
inline _LIBCPP_HIDE_FROM_ABI int __iswpunct(wint_t value, __locale_t) { return std::iswpunct(value); }
inline _LIBCPP_HIDE_FROM_ABI int __iswxdigit(wint_t value, __locale_t) { return std::iswxdigit(value); }
inline _LIBCPP_HIDE_FROM_ABI wint_t __towupper(wint_t value, __locale_t) { return std::towupper(value); }
inline _LIBCPP_HIDE_FROM_ABI wint_t __towlower(wint_t value, __locale_t) { return std::towlower(value); }
