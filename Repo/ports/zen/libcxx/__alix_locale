_LIBCPP_DIAGNOSTIC_PUSH
_LIBCPP_CLANG_DIAGNOSTIC_IGNORED("-Wgcc-compat")
_LIBCPP_GCC_DIAGNOSTIC_IGNORED("-Wformat-nonliteral")
#ifdef _LIBCPP_COMPILER_CLANG_BASED
#define ALIX_LIBCXX_VARIADIC_FORMAT(...) _LIBCPP_ATTRIBUTE_FORMAT(__VA_ARGS__)
#else
#define ALIX_LIBCXX_VARIADIC_FORMAT(...)
#endif

template <class... Args>
_LIBCPP_HIDE_FROM_ABI ALIX_LIBCXX_VARIADIC_FORMAT(__printf__, 4, 5)
int __snprintf(char* output, size_t capacity, __locale_t locale,
                                   const char* format, Args&&... arguments) {
  __locale_guard selected(locale);
  return std::snprintf(output, capacity, format, std::forward<Args>(arguments)...);
}

template <class... Args>
_LIBCPP_HIDE_FROM_ABI ALIX_LIBCXX_VARIADIC_FORMAT(__printf__, 3, 4)
int __asprintf(char** output, __locale_t locale,
                                   const char* format, Args&&... arguments) {
  __locale_guard selected(locale);
  return ::asprintf(output, format, std::forward<Args>(arguments)...);
}
_LIBCPP_DIAGNOSTIC_POP
#undef ALIX_LIBCXX_VARIADIC_FORMAT

