list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/cmake")
set(CMAKE_SYSTEM_NAME Alix)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
get_filename_component(ALIX_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT DEFINED ALIX_LLVM_PREFIX)
  set(ALIX_LLVM_PREFIX "/opt/homebrew/opt/llvm")
endif()
set(CMAKE_C_COMPILER "${ALIX_LLVM_PREFIX}/bin/clang")
set(CMAKE_CXX_COMPILER "${ALIX_LLVM_PREFIX}/bin/clang++")
set(CMAKE_ASM_COMPILER "${ALIX_LLVM_PREFIX}/bin/clang")
set(CMAKE_AR "${ALIX_LLVM_PREFIX}/bin/llvm-ar")
set(CMAKE_RANLIB "${ALIX_LLVM_PREFIX}/bin/llvm-ranlib")
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_ASM_COMPILER_TARGET x86_64-unknown-none-elf)
execute_process(COMMAND "${CMAKE_C_COMPILER}" --no-default-config -print-resource-dir
  OUTPUT_VARIABLE ALIX_CLANG_RESOURCE OUTPUT_STRIP_TRAILING_WHITESPACE)
set(ALIX_RUNTIME_FLAGS "--no-default-config -D__ALIX__ -D_LIBCPP_HAS_CLOCK_GETTIME -ffreestanding -fno-stack-protector -fno-pic -mno-red-zone -mcmodel=large -fshort-wchar -ftls-model=local-exec -nostdinc -isystem ${ALIX_CLANG_RESOURCE}/include -isystem ${ALIX_ROOT}/include -I${ALIX_ROOT}/user/lib -I${ALIX_ROOT}/ports/zen/libcxx")
set(CMAKE_C_FLAGS_INIT "${ALIX_RUNTIME_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${ALIX_RUNTIME_FLAGS} -nostdinc++")
set(CMAKE_ASM_FLAGS_INIT "--no-default-config -mno-red-zone")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-nostdlib -fuse-ld=lld")
set(LLVM_DEFAULT_TARGET_TRIPLE x86_64-unknown-none-elf CACHE STRING "" FORCE)
