+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "AlixTextInput.h"
+#include "mozilla/TextEventDispatcher.h"
+#include "mozilla/TextEvents.h"
+#include "nsString.h"
+namespace mozilla::widget {
+NS_IMPL_ISUPPORTS(AlixTextInput, TextEventDispatcherListener,
+                  nsISupportsWeakReference)
+nsresult AlixTextInput::NotifyIME(TextEventDispatcher *dispatcher,
+                                  const IMENotification &notification) {
+  switch (notification.mMessage) {
+  case REQUEST_TO_COMMIT_COMPOSITION:
+  case REQUEST_TO_CANCEL_COMPOSITION: {
+    if (!dispatcher->IsComposing())
+      return NS_OK;
+    nsEventStatus status = nsEventStatus_eIgnore;
+    return dispatcher->CommitComposition(
+        status, notification.mMessage == REQUEST_TO_CANCEL_COMPOSITION
+                    ? &EmptyString()
+                    : nullptr);
+  }
+  default:
+    // There is no separate Alix IME process to notify of geometry/selection.
+    // Gecko retains composition state; physical input uses native key events.
+    return NS_OK;
+  }
+}
+IMENotificationRequests AlixTextInput::GetIMENotificationRequests() {
+  return {};
+}
+void AlixTextInput::OnRemovedFrom(TextEventDispatcher *) {}
+void AlixTextInput::WillDispatchKeyboardEvent(TextEventDispatcher *,
+                                              WidgetKeyboardEvent &, uint32_t,
+                                              void *) {
+  // Native key values have already been normalized before entering Gecko.
+}
+} // namespace mozilla::widget
