+void nsWindow::NotifyBoundsChanged(const LayoutDeviceIntRect &old) {
+  RefPtr<nsWindow> hold(this);
+  auto bounds = GetBounds();
+  if (mDestroyed)
+    return;
+  if (old.TopLeft() != bounds.TopLeft())
+    NotifyWindowMoved(bounds.TopLeft());
+  if (!mDestroyed && old.Size() != bounds.Size()) {
+    if (mWidgetListener)
+      mWidgetListener->WindowResized(this, bounds.Size());
+    if (!mDestroyed && mAttachedWidgetListener)
+      mAttachedWidgetListener->WindowResized(this, bounds.Size());
+  }
+}
