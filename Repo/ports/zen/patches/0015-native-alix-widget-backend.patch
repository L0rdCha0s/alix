+using namespace mozilla;
+using namespace mozilla::widget;
+
+nsAppShell::nsAppShell() = default;
+nsAppShell::~nsAppShell() = default;
+nsresult nsAppShell::Init() {
+  nsresult result = nsBaseAppShell::Init();
+  if (NS_FAILED(result))
+    return result;
+  if (XRE_IsParentProcess() && gfxPlatform::IsHeadless()) {
+    mHeadlessScreen = MakeUnique<HeadlessScreenHelper>();
+  } else if (XRE_IsParentProcess()) {
+    mDisplay.version = USER_ATK_CONTROL_VERSION;
+    mDisplay.size = sizeof(mDisplay);
+    if (sys_ui_control(0, USER_ATK_CONTROL_DISPLAY, &mDisplay) ||
+        !mDisplay.width || !mDisplay.height)
+      return NS_ERROR_NOT_AVAILABLE;
+    nsTArray<RefPtr<Screen>> screens;
+    LayoutDeviceIntRect rect(0, 0, mDisplay.width, mDisplay.height);
+    screens.AppendElement(MakeRefPtr<Screen>(
+        rect, rect, 24, 24, 0, DesktopToLayoutDeviceScale(),
+        CSSToLayoutDeviceScale(), 96.0f, Screen::IsPseudoDisplay::No,
+        Screen::IsHDR::No, 80.0f, 1000.0f));
+    ScreenManager::Refresh(std::move(screens));
+  }
+  return NS_OK;
+}
+void nsAppShell::ScheduleNativeEventCallback() {
+  MonitorAutoLock lock(mWake);
+  mWakePending = true;
+  lock.NotifyAll();
+}
+bool nsAppShell::ProcessNextNativeEvent(bool mayWait) {
+  bool processed = nsWindow::PumpNativeEvents();
+  bool requested;
+  {
+    MonitorAutoLock lock(mWake);
+    // Alix's window queue has nonblocking polling. Bound the idle wait so
+    // native input is observed without retaining a user stack in a kernel UI
+    // wait.
+    if (mayWait && !processed && !mWakePending)
+      lock.Wait(TimeDuration::FromMilliseconds(10));
+    requested = mWakePending;
+    mWakePending = false;
+  }
+  if (requested)
+    NativeEventCallback();
+  return nsWindow::PumpNativeEvents() || processed || requested;
+}
