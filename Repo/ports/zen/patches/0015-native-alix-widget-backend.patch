+already_AddRefed<DrawTarget> nsWindow::StartRemoteDrawing() {
+  auto size = GetBounds().Size().ToUnknownSize();
+  if (size.IsEmpty())
+    return nullptr;
+  if (!mDrawTarget || mDrawTarget->GetSize() != size)
+    mDrawTarget = Factory::CreateDrawTarget(BackendType::SKIA, size,
+                                            SurfaceFormat::B8G8R8X8);
+  return do_AddRef(mDrawTarget);
+}
+void nsWindow::EndRemoteDrawing() {
+  if (!mDrawTarget || !mHandle)
+    return;
+  RefPtr<SourceSurface> snapshot = mDrawTarget->Snapshot();
+  RefPtr<DataSourceSurface> data =
+      snapshot ? snapshot->GetDataSurface() : nullptr;
+  if (!data)
+    return;
+  auto mapping =
+      MakeUnique<DataSourceSurface::ScopedMap>(data, DataSourceSurface::READ);
+  if (!mapping->IsMapped())
+    return;
+  auto size = data->GetSize();
+  if (size.width <= 0 || size.height <= 0 || size.width > 16384 ||
+      size.height > 16384)
+    return;
+  size_t count = size_t(size.width) * size.height;
+  if (mUploadCapacity < count) {
+    auto replacement = MakeUniqueFallible<uint32_t[]>(count);
+    if (!replacement)
+      return;
+    mUpload = std::move(replacement);
+    mUploadCapacity = count;
+  }
+  for (int row = 0; row < size.height; ++row) {
+    auto *source = reinterpret_cast<const uint32_t *>(
+        mapping->GetData() + row * mapping->GetStride());
+    for (int col = 0; col < size.width; ++col)
+      mUpload[size_t(row) * size.width + col] = source[col] | 0xff000000u;
+  }
+  sys_ui_present(mHandle, mUpload.get(), count * sizeof(uint32_t));
+}
+void nsWindow::CleanupRemoteDrawing() {
+  MutexAutoLock lock(mSurfaceMutex);
+  mDrawTarget = nullptr;
+  mUpload = nullptr;
+  mUploadCapacity = 0;
+}
+void nsWindow::DispatchMouse(const user_atk_event_t &native) {
+  auto bounds = GetBounds();
+  if (mRollupCapture &&
+      (native.flags &
+       (USER_ATK_MOUSE_FLAG_PRESS | USER_ATK_MOUSE_FLAG_RIGHT_PRESS)) &&
+      (native.x < 0 || native.y < 0 || native.x >= bounds.Width() ||
+       native.y >= bounds.Height())) {
+    if (auto *listener = GetActiveRollupListener())
+      listener->Rollup({});
+    return;
+  }
+  auto send = [&](EventMessage message, MouseButton button) {
+    WidgetMouseEvent event(true, message, this, WidgetMouseEvent::eReal);
+    event.mRefPoint = LayoutDeviceIntPoint(native.x, native.y);
+    event.mModifiers = mModifiers;
+    event.mButton = button;
+    event.mButtons = ((native.flags & USER_ATK_MOUSE_FLAG_LEFT)
+                          ? MouseButtonsFlag::ePrimaryFlag
+                          : MouseButtonsFlag::eNoButtons) |
+                     ((native.flags & USER_ATK_MOUSE_FLAG_RIGHT)
+                          ? MouseButtonsFlag::eSecondaryFlag
+                          : MouseButtonsFlag::eNoButtons);
+    if (message == eMouseDown || message == eMouseUp)
+      event.mClickCount = 1;
+    event.AssignEventTime(WidgetEventTime());
+    DispatchInputEvent(&event);
+  };
+  if (native.flags & USER_ATK_MOUSE_FLAG_PRESS)
+    send(eMouseDown, MouseButton::ePrimary);
+  if (!mDestroyed && (native.flags & USER_ATK_MOUSE_FLAG_RELEASE))
+    send(eMouseUp, MouseButton::ePrimary);
+  if (!mDestroyed && (native.flags & USER_ATK_MOUSE_FLAG_RIGHT_PRESS))
+    send(eMouseDown, MouseButton::eSecondary);
+  if (!mDestroyed && (native.flags & USER_ATK_MOUSE_FLAG_RIGHT_RELEASE))
+    send(eMouseUp, MouseButton::eSecondary);
+  if (!mDestroyed &&
+      !(native.flags &
+        (USER_ATK_MOUSE_FLAG_PRESS | USER_ATK_MOUSE_FLAG_RELEASE |
+         USER_ATK_MOUSE_FLAG_RIGHT_PRESS | USER_ATK_MOUSE_FLAG_RIGHT_RELEASE)))
+    send(eMouseMove, MouseButton::eNotPressed);
+}
+void nsWindow::DispatchKey(const user_atk_event_t &native) {
+  uint32_t code = native.data1 & 0x7f;
+  bool released = native.flags & USER_ATK_KEY_FLAG_RELEASE;
+  unsigned index =
+      code + ((native.flags & USER_ATK_KEY_FLAG_EXTENDED) ? 128 : 0);
+  mPressed[index] = !released;
+  if (code == 0x3a && !released && !(native.flags & USER_ATK_KEY_FLAG_REPEAT))
+    mCapsLock = !mCapsLock;
+  mModifiers = (mPressed[0x2a] || mPressed[0x36] ? MODIFIER_SHIFT : 0) |
+               (mPressed[0x1d] || mPressed[0x9d] ? MODIFIER_CONTROL : 0) |
+               (mPressed[0x38] || mPressed[0xb8] ? MODIFIER_ALT : 0) |
+               (mPressed[0xdb] || mPressed[0xdc] ? MODIFIER_META : 0) |
+               (mCapsLock ? MODIFIER_CAPSLOCK : 0);
+  bool modifier = code == 0x2a || code == 0x36 || code == 0x1d ||
+                  code == 0x38 || code == 0x5b || code == 0x5c || code == 0x3a;
+  WidgetKeyboardEvent event(true, released ? eKeyUp : eKeyDown, this);
+  event.mModifiers = mModifiers;
+  event.mIsRepeat = native.flags & USER_ATK_KEY_FLAG_REPEAT;
+  char16_t value = released ? mKeyValues[index] : char16_t(native.data0);
+  if (!released && (mModifiers & MODIFIER_CONTROL) && value >= 1 && value <= 26)
+    value += u'a' - 1;
+  if (!released)
+    mKeyValues[index] = value;
+  else
+    mKeyValues[index] = 0;
+  event.mKeyNameIndex =
+      value ? KEY_NAME_INDEX_USE_STRING : KEY_NAME_INDEX_Unidentified;
+  if (value)
+    event.mKeyValue.Assign(value);
+  if (value >= u'a' && value <= u'z')
+    event.mKeyCode = value - u'a' + NS_VK_A;
+  else if ((value >= u'A' && value <= u'Z') || (value >= u'0' && value <= u'9'))
+    event.mKeyCode = value;
+  if ((code >= 0x3b && code <= 0x44) || code == 0x57 || code == 0x58) {
+    unsigned function = code <= 0x44 ? code - 0x3b : code - 0x57 + 10;
+    event.mKeyNameIndex =
+        static_cast<KeyNameIndex>(KEY_NAME_INDEX_F1 + function);
+    event.mKeyCode = NS_VK_F1 + function;
+  }
+  switch (code) {
+  case 0x47:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Home;
+    event.mKeyCode = NS_VK_HOME;
+    break;
+  case 0x4f:
+    event.mKeyNameIndex = KEY_NAME_INDEX_End;
+    event.mKeyCode = NS_VK_END;
+    break;
+  case 0x49:
+    event.mKeyNameIndex = KEY_NAME_INDEX_PageUp;
+    event.mKeyCode = NS_VK_PAGE_UP;
+    break;
+  case 0x51:
+    event.mKeyNameIndex = KEY_NAME_INDEX_PageDown;
+    event.mKeyCode = NS_VK_PAGE_DOWN;
+    break;
+  case 0x52:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Insert;
+    event.mKeyCode = NS_VK_INSERT;
+    break;
+  case 0x53:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Delete;
+    event.mKeyCode = NS_VK_DELETE;
+    break;
+  case 0x2a:
+  case 0x36:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Shift;
+    event.mKeyCode = NS_VK_SHIFT;
+    break;
+  case 0x1d:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Control;
+    event.mKeyCode = NS_VK_CONTROL;
+    break;
+  case 0x38:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Alt;
+    event.mKeyCode = NS_VK_ALT;
+    break;
+  case 0x5b:
+  case 0x5c:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Meta;
+    event.mKeyCode = NS_VK_META;
+    break;
+  case 0x3a:
+    event.mKeyNameIndex = KEY_NAME_INDEX_CapsLock;
+    event.mKeyCode = NS_VK_CAPS_LOCK;
+    break;
+  case 0x01:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Escape;
+    event.mKeyCode = NS_VK_ESCAPE;
+    break;
+  case 0x0e:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Backspace;
+    event.mKeyCode = NS_VK_BACK;
+    break;
+  case 0x0f:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Tab;
+    event.mKeyCode = NS_VK_TAB;
+    break;
+  case 0x1c:
+    event.mKeyNameIndex = KEY_NAME_INDEX_Enter;
+    event.mKeyCode = NS_VK_RETURN;
+    break;
+  case 0x48:
+    event.mKeyNameIndex = KEY_NAME_INDEX_ArrowUp;
+    event.mKeyCode = NS_VK_UP;
+    break;
+  case 0x50:
+    event.mKeyNameIndex = KEY_NAME_INDEX_ArrowDown;
+    event.mKeyCode = NS_VK_DOWN;
+    break;
+  case 0x4b:
+    event.mKeyNameIndex = KEY_NAME_INDEX_ArrowLeft;
+    event.mKeyCode = NS_VK_LEFT;
+    break;
+  case 0x4d:
+    event.mKeyNameIndex = KEY_NAME_INDEX_ArrowRight;
+    event.mKeyCode = NS_VK_RIGHT;
+    break;
+  }
+  event.AssignEventTime(WidgetEventTime());
+  RefPtr<TextEventDispatcherListener> listener =
+      GetNativeTextEventDispatcherListener();
+  RefPtr<TextEventDispatcher> dispatcher = GetTextEventDispatcher();
+  if (NS_FAILED(dispatcher->BeginNativeInputTransaction()))
+    return;
+  nsEventStatus status = nsEventStatus_eIgnore;
+  dispatcher->DispatchKeyboardEvent(released ? eKeyUp : eKeyDown, event,
+                                    status);
+  if (!released && !mDestroyed && !modifier)
+    dispatcher->MaybeDispatchKeypressEvents(event, status);
+}
+void nsWindow::DispatchNativeEvent(const user_atk_event_t &native) {
+  if (native.type == USER_ATK_EVENT_CLOSE) {
+    if (mWidgetListener)
+      mWidgetListener->RequestWindowClose(this);
+    return;
+  }
+  if (native.type == USER_ATK_EVENT_FOCUS) {
+    if (!native.data0) {
+      mModifiers = 0;
+      memset(mPressed, 0, sizeof(mPressed));
+      memset(mKeyValues, 0, sizeof(mKeyValues));
+    }
+    if (mWidgetListener) {
+      if (native.data0)
+        mWidgetListener->WindowActivated();
+      else
+        mWidgetListener->WindowDeactivated();
+    }
+    return;
+  }
+  if (native.type == USER_ATK_EVENT_RESIZE ||
+      native.type == USER_ATK_EVENT_MOVE) {
+    auto old = GetBounds();
+    {
+      MutexAutoLock lock(mSurfaceMutex);
+      if (Control(USER_ATK_CONTROL_QUERY))
+        AcceptBounds();
+    }
+    NotifyBoundsChanged(old);
+    return;
+  }
+  if (!mEnabled)
+    return;
+  if (native.type == USER_ATK_EVENT_KEY)
+    DispatchKey(native);
+  if (native.type == USER_ATK_EVENT_MOUSE)
+    DispatchMouse(native);
+}
+bool nsWindow::PumpNativeEvents() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!sWindows)
+    return false;
+  nsTArray<RefPtr<nsWindow>> snapshot;
+  for (auto *window : *sWindows)
+    snapshot.AppendElement(window);
+  bool processed = false;
+  for (const auto &window : snapshot) {
+    for (unsigned count = 0;
+         count < 64 && !window->mDestroyed && window->mHandle; ++count) {
+      if (sys_ui_poll_event(window->mHandle, &window->mEvent, 0) <= 0)
+        break;
+      processed = true;
+      // Dispatch may spin a nested native loop and overwrite mEvent. Each
+      // invocation owns an immutable heap snapshot through all callbacks.
+      auto event = MakeUnique<user_atk_event_t>(window->mEvent);
+      window->DispatchNativeEvent(*event);
+    }
+  }
+  return processed;
+}
