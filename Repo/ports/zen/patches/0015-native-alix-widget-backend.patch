+void nsWindow::SetSizeMode(nsSizeMode mode) {
+  RefPtr<nsWindow> hold(this);
+  if (mDestroyed || mSizeMode == mode)
+    return;
+  if (mode == nsSizeMode_Minimized)
+    Show(false);
+  else {
+    if (mSizeMode == nsSizeMode_Normal)
+      mRestoreBounds = GetBounds();
+    if (mode == nsSizeMode_Normal)
+      SetBounds(mRestoreBounds);
+    else if (Control(USER_ATK_CONTROL_QUERY))
+      SetBounds(LayoutDeviceIntRect(0, 0, mControl.screen_width,
+                                    mControl.screen_height));
+    Show(true);
+  }
+  mSizeMode = mode;
+  if (mWidgetListener)
+    mWidgetListener->SizeModeChanged(mode);
+}
+nsresult nsWindow::MakeFullScreen(bool fullscreen) {
+  RefPtr<nsWindow> hold(this);
+  if (mDestroyed)
+    return NS_ERROR_FAILURE;
+  if (mFullscreen == fullscreen)
+    return NS_OK;
+  if (fullscreen)
+    mRestoreBounds = GetBounds();
+  {
+    MutexAutoLock lock(mSurfaceMutex);
+    mControl.flags =
+        fullscreen ? 0
+                   : !(mDescription.flags & USER_ATK_WINDOW_FLAG_BORDERLESS);
+    if (!Control(USER_ATK_CONTROL_CHROME))
+      return NS_ERROR_FAILURE;
+    AcceptBounds();
+  }
+  if (fullscreen) {
+    if (!Control(USER_ATK_CONTROL_QUERY) ||
+        !SetBounds(LayoutDeviceIntRect(0, 0, mControl.screen_width,
+                                       mControl.screen_height)))
+      return NS_ERROR_FAILURE;
+  } else if (!SetBounds(mRestoreBounds))
+    return NS_ERROR_FAILURE;
+  mFullscreen = fullscreen;
+  mSizeMode = fullscreen ? nsSizeMode_Fullscreen : nsSizeMode_Normal;
+  if (mWidgetListener)
+    mWidgetListener->SizeModeChanged(mSizeMode);
+  return NS_OK;
+}
+nsresult nsWindow::SetTitle(const nsAString &title) {
+  auto utf8 = NS_ConvertUTF16toUTF8(title);
+  size_t bytes = std::min<size_t>(utf8.Length(), sizeof(mControl.title) - 1);
+  while (bytes && bytes < utf8.Length() &&
+         (static_cast<unsigned char>(utf8[bytes]) & 0xc0) == 0x80)
+    --bytes;
+  memcpy(mControl.title, utf8.get(), bytes);
+  mControl.title[bytes] = 0;
+  return Control(USER_ATK_CONTROL_TITLE) ? NS_OK : NS_ERROR_FAILURE;
+}
