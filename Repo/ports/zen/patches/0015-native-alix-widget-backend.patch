+nsresult nsWindow::Create(nsIWidget *parent, const LayoutDeviceIntRect &rect,
+                          const InitData &data) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mHandle || mDestroyed || rect.Width() < 0 || rect.Height() < 0)
+    return NS_ERROR_INVALID_ARG;
+  BaseCreate(parent, data);
+  mDescription.width = std::max(1, rect.Width());
+  mDescription.height = std::max(1, rect.Height());
+  mDescription.flags =
+      USER_ATK_WINDOW_FLAG_HIDDEN | USER_ATK_WINDOW_FLAG_RAW_KEYS;
+  if (data.mWindowType == WindowType::TopLevel ||
+      data.mWindowType == WindowType::Dialog)
+    mDescription.flags |= USER_ATK_WINDOW_FLAG_RESIZABLE;
+  if (data.mWindowType == WindowType::Popup ||
+      data.mWindowType == WindowType::Invisible ||
+      data.mBorderStyle == BorderStyle::None)
+    mDescription.flags |= USER_ATK_WINDOW_FLAG_BORDERLESS;
+  int handle = sys_ui_create(&mDescription);
+  if (handle <= 0) {
+    ClearParent();
+    return NS_ERROR_FAILURE;
+  }
+  mHandle = static_cast<uint32_t>(handle);
+  auto initial = rect;
+  if (parent && data.mWindowType == WindowType::Popup)
+    initial.MoveBy(parent->WidgetToScreenOffset());
+  if (!SetBounds(initial)) {
+    sys_ui_close(mHandle);
+    mHandle = 0;
+    mTextInput = nullptr;
+    ClearParent();
+    return NS_ERROR_FAILURE;
+  }
+  mRestoreBounds = GetBounds();
+  if (!sWindows) {
+    sWindows = new nsTArray<nsWindow *>();
+    ClearOnShutdown(&sWindows);
+  }
+  sWindows->AppendElement(this);
+  return NS_OK;
+}
+void nsWindow::Destroy() {
+  RefPtr<nsWindow> hold(this);
+  DestroyImpl();
+}
+void nsWindow::DestroyImpl() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mDestroyed)
+    return;
+  mDestroyed = true;
+  if (sWindows)
+    sWindows->RemoveElement(this);
+  // Quiesce compositor work before closing the native channel or freeing its
+  // target. No surface mutex is held while Gecko joins/stops the compositor.
+  nsTArray<RefPtr<nsIWidget>> children;
+  for (auto *child = GetFirstChild(); child; child = child->GetNextSibling())
+    children.AppendElement(child);
+  for (const auto &child : children)
+    child->Destroy();
+  DestroyLayerManager();
+  nsIWidget::OnDestroy();
+  nsIWidget::Destroy();
+  MutexAutoLock lock(mSurfaceMutex);
+  if (mHandle)
+    sys_ui_close(mHandle);
+  mHandle = 0;
+  mVisible = false;
+  mDrawTarget = nullptr;
+  mUpload = nullptr;
+  mUploadCapacity = 0;
+}
+LayoutDeviceIntRect nsWindow::GetBounds() {
+  MutexAutoLock lock(mGeometryMutex);
+  return mBounds;
+}
+LayoutDeviceIntPoint nsWindow::WidgetToScreenOffset() {
+  return GetBounds().TopLeft();
+}
+void nsWindow::AcceptBounds() {
+  LayoutDeviceIntRect next(mControl.x, mControl.y, mControl.width,
+                           mControl.height);
+  LayoutDeviceIntRect old;
+  {
+    MutexAutoLock lock(mGeometryMutex);
+    old = mBounds;
+    mBounds = next;
+  }
+  if (old.Size() != next.Size())
+    mDrawTarget = nullptr;
+  // Notifications run on the main thread, after the native transaction and
+  // surface lock have completed. PumpNativeEvents also reconciles WM changes.
+}
+bool nsWindow::SetBounds(const LayoutDeviceIntRect &bounds) {
+  RefPtr<nsWindow> hold(this);
+  MOZ_ASSERT(NS_IsMainThread());
+  auto old = GetBounds();
+  {
+    MutexAutoLock lock(mSurfaceMutex);
+    mControl.x = bounds.X();
+    mControl.y = bounds.Y();
+    mControl.width = std::max(1, bounds.Width());
+    mControl.height = std::max(1, bounds.Height());
+    if (!Control(USER_ATK_CONTROL_BOUNDS))
+      return false;
+    AcceptBounds();
+  }
+  NotifyBoundsChanged(old);
+  return true;
+}
+void nsWindow::Show(bool visible) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mDestroyed || !mHandle)
+    return;
+  mControl.flags = visible ? 1 : 0;
+  if (Control(USER_ATK_CONTROL_VISIBLE)) {
+    mVisible = visible;
+    if (visible) {
+      RefPtr<nsWindow> hold(this);
+      if (mWindowType == WindowType::TopLevel ||
+          mWindowType == WindowType::Dialog)
+        SetFocus(Raise::Yes, mozilla::dom::CallerType::System);
+      Invalidate(GetBounds());
+    }
+  }
+}
+void nsWindow::SetFocus(Raise, mozilla::dom::CallerType) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mDestroyed && mHandle && mVisible && mEnabled)
+    Control(USER_ATK_CONTROL_FOCUS);
+}
