+nsresult GfxInfo::GetFeatureStatusImpl(
+    int32_t aFeature, int32_t *aStatus, nsAString &aSuggestedDriverVersion,
+    const nsTArray<RefPtr<GfxDriverInfo>> &aDriverInfo, nsACString &aFailureId,
+    OperatingSystem *aOS /* = nullptr */) {
+  NS_ENSURE_ARG_POINTER(aStatus);
+  aSuggestedDriverVersion.SetIsVoid(true);
+  *aStatus = nsIGfxInfo::FEATURE_STATUS_UNKNOWN;
+  if (aOS)
+    *aOS = OperatingSystem::Unknown;
+
+  if (sShutdownOccurred) {
+    return NS_OK;
+  }
+
+  // Alix currently exposes CPU surfaces, with no native OpenGL context API.
+  // Report the actual capability so Gecko can choose its software renderer.
+  if (aFeature == nsIGfxInfo::FEATURE_OPENGL_LAYERS ||
+      aFeature == nsIGfxInfo::FEATURE_WEBGL_OPENGL) {
+    *aStatus = nsIGfxInfo::FEATURE_BLOCKED_DEVICE;
+    aFailureId.AssignLiteral("FEATURE_FAILURE_ALIX_NO_NATIVE_GL");
+    return NS_OK;
+  }
+
+  return GfxInfoBase::GetFeatureStatusImpl(
+      aFeature, aStatus, aSuggestedDriverVersion, aDriverInfo, aFailureId, aOS);
+}
