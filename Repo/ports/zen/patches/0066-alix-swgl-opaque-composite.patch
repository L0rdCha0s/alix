+static inline void composite_chunk(uint32_t* dst, PackedRGBA8 packed) {
+  U32 words = bit_cast<U32>(packed);
+  if ((packed[3] & packed[7] & packed[11] & packed[15]) == 255) {
+    unaligned_store(dst, packed);
+    return;
+  }
+  if ((words.x | words.y | words.z | words.w) == 0) {
+    return;
+  }
+  WideRGBA8 srcpx = unpack(packed);
+  WideRGBA8 dstpx = unpack(unaligned_load<PackedRGBA8>(dst));
+  unaligned_store(dst, pack(srcpx + dstpx - muldiv255(dstpx, alphas(srcpx))));
+}
