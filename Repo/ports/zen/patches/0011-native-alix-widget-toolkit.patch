+
+# Alix uses its native PCM channel, not a Unix host sound server.
+@depends("--enable-audio-backends", target)
+def imply_alix_audio(values, target):
+    enabled = "alix" in values
+    if enabled and target.os != "Alix":
+        die("Cannot enable Alix audio on %s", target.os)
+    return enabled or None
+
+
+set_config("MOZ_ALIX_AUDIO", imply_alix_audio, when="--enable-audio-backends")
