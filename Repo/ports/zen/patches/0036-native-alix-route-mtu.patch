+// Native Alix route snapshots. No route socket or foreign OS ABI is selected.
+use std::{io::{self, Error, ErrorKind}, net::IpAddr};
+
+#[repr(C)]
+struct RouteInfo {
+    version: u32,
+    mtu: u32,
+    source_ipv4: u32,
+    next_hop_ipv4: u32,
+    interface_name: [u8; 8],
+}
+const _: () = assert!(std::mem::size_of::<RouteInfo>() == 24);
+const _: () = assert!(std::mem::offset_of!(RouteInfo, interface_name) == 16);
+unsafe extern "C" {
+    fn alix_net_route_ipv4(destination: u32, info: *mut RouteInfo) -> core::ffi::c_int;
+}
+
+pub fn interface_and_mtu_impl(remote: IpAddr) -> io::Result<(String, usize)> {
+    let IpAddr::V4(remote) = remote else {
+        return Err(Error::new(ErrorKind::Unsupported, "Alix has no IPv6 route interface"));
+    };
+    let mut info = std::mem::MaybeUninit::<RouteInfo>::uninit();
+    // This bounded synchronous call copies a kernel-owned value to the caller.
+    // No worker retains the pointer or borrows the caller's stack.
+    if unsafe { alix_net_route_ipv4(remote.to_bits(), info.as_mut_ptr()) } != 0 {
+        return Err(Error::last_os_error());
+    }
+    let info = unsafe { info.assume_init() };
+    if info.version != 1 || info.mtu < 68 {
+        return Err(Error::new(ErrorKind::InvalidData, "Invalid native route snapshot"));
+    }
+    let end = info.interface_name.iter().position(|&byte| byte == 0)
+        .filter(|&end| end > 0)
+        .ok_or_else(|| Error::new(ErrorKind::InvalidData, "Invalid native interface name"))?;
+    let name = String::from_utf8(info.interface_name[..end].to_vec())
+        .map_err(|_| Error::new(ErrorKind::InvalidData, "Invalid native interface name"))?;
+    Ok((name, info.mtu as usize))
+}
