+
+using namespace mozilla;
+using namespace mozilla::gfx;
+
+gfxAlixPlatform::gfxAlixPlatform() {
+  mFTLibrary = Factory::NewFTLibrary();
+  MOZ_RELEASE_ASSERT(mFTLibrary);
+  Factory::SetFTLibrary(mFTLibrary);
+  InitBackendPrefs(GetBackendPrefs());
+}
+
+gfxAlixPlatform::~gfxAlixPlatform() {
+  Factory::ReleaseFTLibrary(mFTLibrary);
+}
+
+already_AddRefed<gfxASurface> gfxAlixPlatform::CreateOffscreenSurface(
+    const IntSize& aSize, gfxImageFormat aFormat) {
+  if (!Factory::AllowedSurfaceSize(aSize)) return nullptr;
+  RefPtr<gfxASurface> surface = new gfxImageSurface(aSize, aFormat);
+  return surface.forget();
+}
+
+bool gfxAlixPlatform::CreatePlatformFontList() {
+  return gfxPlatformFontList::Initialize(new gfxFT2FontList);
+}
+
+void gfxAlixPlatform::ReadSystemFontList(dom::SystemFontList* aList) {
+  gfxFT2FontList::PlatformFontList()->ReadSystemFontList(aList);
+}
+
+void gfxAlixPlatform::GetCommonFallbackFonts(
+    uint32_t aCh, Script aScript, FontPresentation aPresentation,
+    nsTArray<const char*>& aFonts) {
+  if (PrefersColor(aPresentation)) {
+    aFonts.AppendElement("Twemoji Mozilla");
+    aFonts.AppendElement("Noto Color Emoji");
+  }
+  aFonts.AppendElement("DejaVu Sans");
+  aFonts.AppendElement("Charis SIL Compact");
+  aFonts.AppendElement("Fira Code");
+}
+
+already_AddRefed<VsyncSource>
+gfxAlixPlatform::CreateGlobalHardwareVsyncSource() {
+  return GetSoftwareVsyncSource();
+}
