--- /dev/null
+++ b/gfx/thebes/AlixFontFiles.cpp
@@ -0,0 +1,59 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "AlixFontFiles.h"
+#include <dirent.h>
+#include <cstring>
+#include <limits.h>
+#include <memory>
+#include <string>
+#include <strings.h>
+#include <sys/stat.h>
+#include <vector>
+
+namespace mozilla::gfx {
+size_t EnumerateAlixFontFiles(const char* aRoot, AlixFontFileCallback aCallback,
+                              void* aContext) {
+  if (!aRoot || !*aRoot || !aCallback) return 0;
+  std::vector<std::string> pending{aRoot};
+  size_t count = 0;
+  auto info = std::make_unique<struct stat>();
+  while (!pending.empty()) {
+    std::string path = std::move(pending.back());
+    pending.pop_back();
+    if (path.size() >= PATH_MAX) continue;
+    std::unique_ptr<DIR, decltype(&closedir)> directory(opendir(path.c_str()),
+                                                       closedir);
+    if (!directory) continue;
+    while (dirent* entry = readdir(directory.get())) {
+      if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..")) continue;
+      std::string child = path + "/" + entry->d_name;
+      if (child.size() >= PATH_MAX) continue;
+      unsigned type = entry->d_type;
+      if (type == DT_UNKNOWN) {
+        if (lstat(child.c_str(), info.get())) continue;
+        type = S_ISDIR(info->st_mode) ? DT_DIR : S_ISREG(info->st_mode) ? DT_REG :
+               S_ISLNK(info->st_mode) ? DT_LNK : DT_UNKNOWN;
+      }
+      if (type == DT_DIR) {
+        pending.push_back(std::move(child));
+        continue;
+      }
+      if (type == DT_LNK) {
+        if (stat(child.c_str(), info.get()) || !S_ISREG(info->st_mode)) continue;
+      } else if (type != DT_REG) {
+        continue;
+      }
+      std::string::size_type extension = child.rfind('.');
+      if (extension == std::string::npos) continue;
+      const char* suffix = child.c_str() + extension;
+      if (strcasecmp(suffix, ".ttf") && strcasecmp(suffix, ".otf") &&
+          strcasecmp(suffix, ".ttc") && strcasecmp(suffix, ".woff")) continue;
+      aCallback(child.c_str(), aContext);
+      ++count;
+    }
+  }
+  return count;
+}
+}
