+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "primpl.h"
+
+/* Native pthread creation, TLS, scheduling and stack mappings belong to Alix's
+ * libc/kernel. No cooperative NSPR context or per-CPU scheduler is installed. */
+void _MD_EarlyInit(void) {}
+
+PRWord* _MD_HomeGCRegisters(PRThread* thread, int isCurrent, int* count)
+{
+    /* As on the other pthread NSPR ports, register homing is handled by the
+     * pthread suspend/GC protocol, not by a second saved execution context. */
+    *count = 0;
+    return NULL;
+}
