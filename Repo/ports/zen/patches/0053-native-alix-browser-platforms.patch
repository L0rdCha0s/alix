--- /dev/null
+++ b/image/decoders/icon/alix/nsIconChannel.cpp
@@ -0,0 +1,28 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsIconChannel.h"
+#include "nsIIconURI.h"
+#include "nsStringStream.h"
+#include "nsNetUtil.h"
+#include "nsString.h"
+
+NS_IMPL_ISUPPORTS(nsIconChannel, nsIRequest, nsIChannel)
+
+nsresult nsIconChannel::Init(nsIURI* aURI, nsILoadInfo* aLoadInfo) {
+  nsCOMPtr<nsIMozIconURI> icon = do_QueryInterface(aURI);
+  NS_ENSURE_TRUE(icon, NS_ERROR_MALFORMED_URI);
+  uint32_t size = 16;
+  MOZ_TRY(icon->GetImageSize(&size));
+  NS_ENSURE_TRUE(size > 0 && size < 256, NS_ERROR_INVALID_ARG);
+  nsAutoCString svg("<svg xmlns='http://www.w3.org/2000/svg' width='");
+  svg.AppendInt(size);
+  svg.AppendLiteral("' height='");
+  svg.AppendInt(size);
+  svg.AppendLiteral("' viewBox='0 0 24 24'><path fill='#e1e5eb' stroke='#607080' d='M5 2h9l5 5v15H5z'/><path fill='none' stroke='#607080' d='M14 2v6h5M8 12h8M8 16h8'/></svg>");
+  nsCOMPtr<nsIInputStream> stream;
+  MOZ_TRY(NS_NewCStringInputStream(getter_AddRefs(stream), svg));
+  return NS_NewInputStreamChannelInternal(getter_AddRefs(mRealChannel), aURI,
+      stream.forget(), "image/svg+xml"_ns, ""_ns, aLoadInfo);
+}
