+#include "mozilla/intl/Locale.h"
+#include "OSPreferences.h"
+using namespace mozilla;
+using namespace mozilla::intl;
+OSPreferences::OSPreferences() = default;
+bool OSPreferences::ReadSystemLocales(nsTArray<nsCString>& aLocales) {
+  nsAutoCString locale(Locale::GetDefaultLocale());
+  if (!CanonicalizeLanguageTag(locale)) return false;
+  aLocales.AppendElement(locale);
+  return true;
+}
+bool OSPreferences::ReadRegionalPrefsLocales(nsTArray<nsCString>& aLocales) {
+  nsAutoCString locale(setlocale(LC_TIME, nullptr));
+  if (!CanonicalizeLanguageTag(locale)) return false;
+  aLocales.AppendElement(locale);
+  return true;
+}
+bool OSPreferences::ReadDateTimePattern(DateTimeFormatStyle aDate,
+    DateTimeFormatStyle aTime, const nsACString& aLocale, nsACString& aResult) {
+  nsAutoCString skeleton;
+  if (!GetDateTimeSkeletonForStyle(aDate, aTime, aLocale, skeleton)) return false;
+  int cycle = LookAndFeel::GetInt(LookAndFeel::IntID::HourCycle);
+  if (cycle == 12 || cycle == 24) OverrideSkeletonHourCycle(cycle == 24, skeleton);
+  return GetPatternForSkeleton(skeleton, aLocale, aResult);
+}
+void OSPreferences::RemoveObservers() {}
