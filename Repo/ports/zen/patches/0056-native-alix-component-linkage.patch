+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "mozilla/ProcInfo.h"
+#include "mozilla/CheckedInt.h"
+#include <time.h>
+#include <unistd.h>
+#include <usyscall.h>
+namespace mozilla {
+nsresult GetCurrentProcessMemoryUsage(uint64_t* aResult) {
+  if (!aResult) return NS_ERROR_INVALID_ARG;
+  syscall_resource_usage_v2_t usage = {};
+  if (sys_resource_usage(SYSCALL_USAGE_SELF, &usage.usage, sizeof(usage)) < 0 ||
+      usage.usage.version != SYSCALL_USAGE_VERSION_2) return NS_ERROR_FAILURE;
+  // Resident user mappings are measured by Alix; shared mappings are charged
+  // to each process, so this is an upper estimate of private physical usage.
+  CheckedUint64 bytes = CheckedUint64(usage.resident_pages) * 4096;
+  if (!bytes.isValid()) return NS_ERROR_FAILURE;
+  *aResult = bytes.value();
+  return NS_OK;
+}
+nsresult GetCpuTimeSinceProcessStartInMs(uint64_t* aResult) {
+  if (!aResult) return NS_ERROR_INVALID_ARG;
+  timespec time = {};
+  if (clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &time) || time.tv_sec < 0) return NS_ERROR_FAILURE;
+  CheckedUint64 value = CheckedUint64(uint64_t(time.tv_sec)) * 1000 + uint64_t(time.tv_nsec) / 1000000;
+  if (!value.isValid()) return NS_ERROR_FAILURE;
+  *aResult = value.value();
+  return NS_OK;
+}
+nsresult GetGpuTimeSinceProcessStartInMs(uint64_t*) {
+  // The native compositor is software rendered; there is no hardware GPU clock.
+  return NS_ERROR_NOT_AVAILABLE;
+}
+ProcInfoPromise::ResolveOrRejectValue GetProcInfoSync(nsTArray<ProcInfoRequest>&& aRequests) {
+  ProcInfoPromise::ResolveOrRejectValue result;
+  HashMap<base::ProcessId, ProcInfo> processes;
+  if (!processes.reserve(aRequests.Length())) { result.SetReject(NS_ERROR_OUT_OF_MEMORY); return result; }
+  for (const auto& request : aRequests) {
+    // Resource-usage snapshots currently address the calling process only.
+    if (request.pid != getpid()) continue;
+    ProcInfo info;
+    info.pid = request.pid;
+    info.childId = dom::ContentParentId(request.childId);
+    info.type = request.processType;
+    info.origin = request.origin;
+    info.windows = request.windowInfo;
+    info.utilityActors = request.utilityInfo;
+    uint64_t milliseconds;
+    nsresult rv = GetCurrentProcessMemoryUsage(&info.memory);
+    if (NS_SUCCEEDED(rv)) rv = GetCpuTimeSinceProcessStartInMs(&milliseconds);
+    if (NS_FAILED(rv)) { result.SetReject(rv); return result; }
+    CheckedUint64 nanoseconds = CheckedUint64(milliseconds) * 1000000;
+    if (!nanoseconds.isValid()) { result.SetReject(NS_ERROR_FAILURE); return result; }
+    info.cpuTime = nanoseconds.value();
+    if (!processes.put(request.pid, std::move(info))) { result.SetReject(NS_ERROR_OUT_OF_MEMORY); return result; }
+  }
+  result.SetResolve(std::move(processes));
+  return result;
+}
+}
