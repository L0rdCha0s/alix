+#include "nsIBidiKeyboard.h"
+#include "MediaKeysEventSourceFactory.h"
+
+namespace {
+class AlixBidiKeyboard final : public nsIBidiKeyboard {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_IMETHOD Reset() override { return NS_OK; }
+  NS_IMETHOD IsLangRTL(bool* aResult) override {
+    *aResult = false;
+    return NS_ERROR_FAILURE;
+  }
+  NS_IMETHOD GetHaveBidiKeyboards(bool* aResult) override {
+    // Alix currently exposes one US keyboard map through its window service.
+    *aResult = false;
+    return NS_OK;
+  }
+ private:
+  ~AlixBidiKeyboard() = default;
+};
+NS_IMPL_ISUPPORTS(AlixBidiKeyboard, nsIBidiKeyboard)
+}
+already_AddRefed<nsIBidiKeyboard> nsIWidget::CreateBidiKeyboardInner() {
+  return mozilla::MakeAndAddRef<AlixBidiKeyboard>();
+}
+namespace mozilla::widget {
+mozilla::dom::MediaControlKeySource* CreateMediaControlKeySource() {
+  // There is no separate system media-key service on Alix. Window keyboard
+  // events continue through nsWindow and DOM media-session APIs remain active.
+  return nullptr;
+}
+}
