+// Fixed native descriptor sets and timeval follow Alix's public headers.
+pub const FD_SETSIZE: usize = 256;
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct fd_set { pub fds_bits: [c_ulong; FD_SETSIZE / 64] }
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct timeval { pub tv_sec: time_t, pub tv_usec: suseconds_t }
+extern "C" {
+    pub fn select(nfds: c_int, read: *mut fd_set, write: *mut fd_set,
+                  except: *mut fd_set, timeout: *mut timeval) -> c_int;
+}
+f! {
+    pub fn FD_ZERO(set: *mut fd_set) -> () {
+        for word in &mut (*set).fds_bits { *word = 0; }
+    }
+    pub fn FD_SET(fd: c_int, set: *mut fd_set) -> () {
+        if fd >= 0 && (fd as usize) < FD_SETSIZE {
+            (*set).fds_bits[fd as usize / 64] |= 1 << (fd as usize % 64);
+        }
+    }
+    pub fn FD_CLR(fd: c_int, set: *mut fd_set) -> () {
+        if fd >= 0 && (fd as usize) < FD_SETSIZE {
+            (*set).fds_bits[fd as usize / 64] &= !(1 << (fd as usize % 64));
+        }
+    }
+    pub fn FD_ISSET(fd: c_int, set: *const fd_set) -> bool {
+        fd >= 0 && (fd as usize) < FD_SETSIZE &&
+            ((*set).fds_bits[fd as usize / 64] & (1 << (fd as usize % 64))) != 0
+    }
+}
