+//! Native Alix datagrams with real per-packet ECN and endpoint metadata.
+use std::{io::{self, IoSliceMut}, net::{IpAddr, Ipv4Addr, SocketAddr}, os::fd::AsRawFd,
+    sync::Mutex, time::Instant};
+use super::{EcnCodepoint, IO_ERROR_LOG_INTERVAL, RecvMeta, Transmit, UdpSockRef, log_sendmsg_error};
+
+#[repr(C)]
+struct PacketInfo {
+    version: u32, source: u32, destination: u32, length: u32, interface_index: u32,
+    source_port: u16, tos: u8, ttl: u8,
+}
+const _: () = assert!(std::mem::size_of::<PacketInfo>() == 24);
+unsafe extern "C" {
+    fn alix_udp_send(fd: i32, data: *const u8, length: usize, destination: *const core::ffi::c_void,
+                     destination_length: u32, tos: i32, source_ipv4: u32) -> isize;
+    fn alix_udp_recv(fd: i32, data: *mut u8, length: usize, info: *mut PacketInfo, flags: i32) -> isize;
+}
+#[derive(Debug)]
+pub struct UdpSocketState { last_send_error: Mutex<Instant> }
+impl UdpSocketState {
+    pub fn new(socket: UdpSockRef<'_>) -> io::Result<Self> {
+        socket.set_nonblocking(true)?;
+        let now = Instant::now();
+        Ok(Self { last_send_error: Mutex::new(now.checked_sub(2 * IO_ERROR_LOG_INTERVAL).unwrap_or(now)) })
+    }
+    #[deprecated(note = "silences I/O errors; use UdpSocketState::try_send instead")]
+    pub fn send(&self, socket: UdpSockRef<'_>, transmit: &Transmit<'_>) -> io::Result<()> {
+        match self.try_send(socket, transmit) {
+            Ok(()) => Ok(()),
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => Err(error),
+            Err(error) => { log_sendmsg_error(&self.last_send_error, error, transmit); Ok(()) }
+        }
+    }
+    pub fn try_send(&self, socket: UdpSockRef<'_>, transmit: &Transmit<'_>) -> io::Result<()> {
+        if !transmit.destination.is_ipv4() {
+            return Err(io::Error::new(io::ErrorKind::Unsupported, "Alix has no IPv6 datagram transport"));
+        }
+        if transmit.effective_segment_size().is_some() {
+            return Err(io::Error::new(io::ErrorKind::Unsupported, "Alix has no UDP segmentation offload"));
+        }
+        let source = match transmit.src_ip {
+            Some(IpAddr::V4(ip)) => ip.to_bits(), None => 0,
+            _ => return Err(io::Error::new(io::ErrorKind::Unsupported, "IPv6 datagram source")),
+        };
+        let address = socket2::SockAddr::from(transmit.destination);
+        let count = unsafe { alix_udp_send(socket.0.as_raw_fd(), transmit.contents.as_ptr(), transmit.contents.len(),
+            address.as_ptr().cast(), address.len(), transmit.ecn.map_or(0, |ecn| ecn as i32), source) };
+        if count < 0 { return Err(io::Error::last_os_error()); }
+        if count as usize != transmit.contents.len() { return Err(io::Error::new(io::ErrorKind::WriteZero, "short native datagram")); }
+        Ok(())
+    }
+    pub fn recv(&self, socket: UdpSockRef<'_>, bufs: &mut [IoSliceMut<'_>], meta: &mut [RecvMeta]) -> io::Result<usize> {
+        if bufs.is_empty() || meta.is_empty() { return Err(io::ErrorKind::InvalidInput.into()); }
+        let mut info = std::mem::MaybeUninit::<PacketInfo>::uninit();
+        let count = unsafe { alix_udp_recv(socket.0.as_raw_fd(), bufs[0].as_mut_ptr(), bufs[0].len(), info.as_mut_ptr(), 0) };
+        if count < 0 { return Err(io::Error::last_os_error()); }
+        let info = unsafe { info.assume_init() };
+        if info.version != 1 || count as u32 != info.length {
+            return Err(io::Error::new(io::ErrorKind::InvalidData, "truncated/invalid native datagram metadata"));
+        }
+        meta[0] = RecvMeta { addr: SocketAddr::from((Ipv4Addr::from_bits(info.source), info.source_port)),
+            len: count as usize, stride: count as usize, ecn: EcnCodepoint::from_bits(info.tos),
+            dst_ip: Some(Ipv4Addr::from_bits(info.destination).into()),
+            interface_index: Some(info.interface_index), timestamp: None };
+        Ok(1)
+    }
+    pub fn max_gso_segments(&self) -> usize { 1 }
+    pub fn gro_segments(&self) -> usize { 1 }
+    pub fn may_fragment(&self) -> bool { false }
+    pub fn set_send_buffer_size(&self, socket: UdpSockRef<'_>, bytes: usize) -> io::Result<()> { socket.0.set_send_buffer_size(bytes) }
+    pub fn set_recv_buffer_size(&self, socket: UdpSockRef<'_>, bytes: usize) -> io::Result<()> { socket.0.set_recv_buffer_size(bytes) }
+    pub fn send_buffer_size(&self, socket: UdpSockRef<'_>) -> io::Result<usize> { socket.0.send_buffer_size() }
+    pub fn recv_buffer_size(&self, socket: UdpSockRef<'_>) -> io::Result<usize> { socket.0.recv_buffer_size() }
+}
+pub(crate) const BATCH_SIZE: usize = 1;
