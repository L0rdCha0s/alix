+@imports(_from="__builtin__", _import="open")
+def rust_archive_is_alix(path):
+    # The custom target must produce native ELF objects, not just a nonempty
+    # host archive. Symbol/name tables and Rust metadata are not ELF members.
+    found = False
+    with open(path, "rb") as archive:
+        if archive.read(8) != b"!<arch>\n":
+            return False
+        while True:
+            header = archive.read(60)
+            if not header:
+                break
+            if len(header) != 60 or header[-2:] != b"`\n":
+                return False
+            size = int(header[48:58])
+            if size < 0:
+                return False
+            data = archive.read(size)
+            if len(data) != size:
+                return False
+            if header[:3] == b"#1/":
+                data = data[int(header[3:16]):]
+            if data[:4] == b"\x7fELF":
+                if len(data) < 20 or data[4:6] != b"\x02\x01" or data[18:20] != b"\x3e\x00":
+                    return False
+                found = True
+            elif data[:4] in (b"\xcf\xfa\xed\xfe", b"\xfe\xed\xfa\xcf",
+                               b"\xce\xfa\xed\xfe", b"\xfe\xed\xfa\xce"):
+                return False
+            if size & 1:
+                archive.read(1)
+    return found
+
