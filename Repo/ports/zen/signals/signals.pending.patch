+            uint64_t bit = signal_bit(number);
+            alix_siginfo_t info = {.si_signo = number,
+                                   .si_code = ALIX_SI_USER,
+                                   .si_pid = (int32_t)self->process->pid,
+                                   .si_uid = self->process->uid,
+                                   .si_tid = self->tid};
