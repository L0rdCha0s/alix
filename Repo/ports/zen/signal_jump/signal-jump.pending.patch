+        "movl %%esi, %%r10d\n"
+        "movq %%rdi, %%rsi\n"
+        "movl $1, %%edi\n"
+        "movl $128, %%edx\n"
+        "movl %[number], %%eax\n"
+        "int $0x80\n"
