+        "movl $127, %%edi\n"
+        "movl %[exit_number], %%eax\n"
+        "int $0x80\n"
+        "ud2\n"
+        : : [number] "i" (SYSCALL_SIGNAL_JUMP), [exit_number] "i" (SYSCALL_EXIT) : "memory", "cc");
+}
